{
  "$id": "market-state",
  "type": "object",
  "required": ["market_id", "inventories", "prices", "player_impact", "knowledge"],
  "properties": {
    "market_id": { "type": "string" },
    "inventories": {
      "type": "object",
      "description": "ECON-INV-09: reserved <= quantity проверяется в runtime (TKT-M5-010); схема фиксирует только неотрицательность.",
      "additionalProperties": {
        "type": "object",
        "required": ["quantity", "reserved"],
        "properties": {
          "quantity": { "type": "integer", "minimum": 0 },
          "reserved": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "prices": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["current", "trend", "last_tick"],
        "properties": {
          "current": { "type": "number" },
          "trend": { "type": "number" },
          "last_tick": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "player_impact": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sold_total", "bought_total"],
        "properties": {
          "sold_total": { "type": "number", "minimum": 0 },
          "bought_total": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "knowledge": {
      "type": "object",
      "required": ["visited", "hearsay"],
      "properties": {
        "visited": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["last_seen_price", "last_seen_tick"],
            "properties": {
              "last_seen_price": { "type": "number" },
              "last_seen_tick": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          }
        },
        "hearsay": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["rough_price", "confidence"],
            "properties": {
              "rough_price": { "type": "number" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
