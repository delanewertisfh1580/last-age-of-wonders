{
  "$id": "recipe-definition",
  "type": "object",
  "required": ["id", "display_name_key", "kind", "inputs", "outputs", "origin_tags", "duration_policy_id"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "display_name_key": { "type": "string", "pattern": "^[a-z0-9.\\-]+$" },
    "kind": { "enum": ["production", "conversion", "refinement"] },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["good_id", "quantity_policy_id"],
        "properties": {
          "good_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "quantity_policy_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["good_id", "quantity_policy_id"],
        "properties": {
          "good_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "quantity_policy_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "origin_tags": { "type": "array", "items": { "enum": ["science", "magic", "hybrid", "neutral"] } },
    "duration_policy_id": { "type": "string" },
    "loss_fraction_policy_id": { "type": "string" },
    "risk_policy_id": { "type": "string" }
  },
  "if": { "properties": { "kind": { "const": "conversion" } } },
  "then": { "required": ["loss_fraction_policy_id", "risk_policy_id"] },
  "additionalProperties": false
}
